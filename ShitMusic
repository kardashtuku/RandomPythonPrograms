    keyDd.config(bg="gray")
    keyFf.config(bg="gray")
    keyGg.config(bg="gray")
    chordTVar.set(selectedChord.get())
    chordlist = []
    chordlist.append(dungus[root])
    if(selectedChord.get()=='Major Chord'):
        chordVar.set(dungus[root] + " – " + dungus[root + 4] + " – " + dungus[root + 7])
        chordlist.append(dungus[root + 4])
        chordlist.append(dungus[root + 7])
    elif(selectedChord.get()=='Minor Chord'):
        chordVar.set(dungus[root] + " – " + dungus[root + 3] + " – " + dungus[root + 7])
        chordlist.append(dungus[root + 3])
        chordlist.append(dungus[root + 7])
    elif(selectedChord.get()=='Diminished Chord'):
        chordVar.set(dungus[root] + " – " + dungus[root + 3] + " – " + dungus[root + 6])
        chordlist.append(dungus[root + 3])
        chordlist.append(dungus[root + 6])
    else:
        chordVar.set(dungus[root] + " – " + dungus[root + 4] + " – " + dungus[root + 8])
        chordlist.append(dungus[root + 4])
        chordlist.append(dungus[root + 8])

    chord_to_key = {
        "A": keyA,
        "B": keyB,
        "C": keyC,
        "D": keyD,
        "E": keyE,
        "F": keyF,
        "G": keyG,
        "A#": keyAa, "Bb": keyAa,
        "C#": keyCc, "Db": keyCc,
        "D#": keyDd, "Eb": keyDd,
        "F#": keyFf, "Gb": keyFf,
        "G#": keyGg, "Ab": keyGg
    }

    for chord in chordlist:
        if chord in chord_to_key:
            chord_to_key[chord].config(bg="Yellow")

