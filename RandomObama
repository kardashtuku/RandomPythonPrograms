import random as rand
import keyboard
import win32api, win32con
import webbrowser
import time

import time
def randobama():
    linky = 'https://youtu.be/oOv34VgyPgA'
    webbrowser.open(f"{linky}?t={rand.randint(0,4600)}s")

while True:
    try:
        if keyboard.is_pressed(';'):
            randobama()
            time.sleep(1);
    except:
        win32api.mouse_event(win32con.MOUSEEVENTF_LEFTUP, 0, 0, 0, 0)
        break

