def move():
    global pressy
    r = rand.randint(1,10)

    if(r <= 6):
        if (pressy == True):
            keyboard.press('w')
            pressy = False
        else:
            keyboard.release('w')
            pressy = True
    elif (r == 7):
        if (pressy == True):
            keyboard.press('s')
            pressy = False
        else:
            keyboard.release('s')
            pressy = True
    elif (r == 8):
        if (pressy == True):
            keyboard.press('a')
            pressy = False
        else:
            keyboard.release('a')
            pressy = True
    elif (r == 9):
        if (pressy == True):
            keyboard.press('shift')
            pressy = False
        else:
            keyboard.release('shift')
            pressy = True
    else:
        if (pressy == True):
            keyboard.press('d')
            pressy = False
        else:
            keyboard.release('d')
            pressy = True
